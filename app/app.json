{
  "expo": {
    "name": "Dream DNA",
    "slug": "dreamlens",
    "scheme": "dreamlens",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "favicon": "./assets/brand/dream-dna-owl.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Dream DNA to record a dream for transcription.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:5000",
      "mockApi": true,
      "cognitoDomain": "",
      "cognitoClientId": ""
    }
  }
}
