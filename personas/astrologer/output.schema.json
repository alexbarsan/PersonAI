{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamlens.local/schemas/astrologer-output-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summary",
    "cosmicWeather",
    "focusAreas",
    "guidance",
    "reflectionPrompts",
    "confidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "cosmicWeather": {
      "type": "string",
      "minLength": 1
    },
    "focusAreas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "guidance": {
      "type": "string",
      "minLength": 1
    },
    "reflectionPrompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
