{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamlens.local/schemas/dream-interpreter-output-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summary",
    "symbols",
    "emotions",
    "themes",
    "interpretation",
    "guidance",
    "followUpQuestions",
    "safety",
    "confidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "meaning", "personalRelevance"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "meaning": { "type": "string", "minLength": 1 },
          "personalRelevance": { "type": "string" }
        }
      }
    },
    "emotions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "intensity", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "themes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "guidance": {
      "type": "string",
      "minLength": 1
    },
    "followUpQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selfHarmRisk", "notes"],
      "properties": {
        "selfHarmRisk": {
          "type": "string",
          "enum": ["none", "low", "elevated"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
