{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "observations", "caveat", "referencedDreamIds"],
  "properties": {
    "answer": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "observations": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "caveat": { "type": "string", "minLength": 1, "maxLength": 500 },
    "referencedDreamIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    }
  }
}
