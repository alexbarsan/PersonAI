aws_region  = "us-east-1"
domain_name = "dreamdna.world"

subject_alternative_names = [
  "*.dreamdna.world",
  "*.dev.dreamdna.world",
  "*.qa.dreamdna.world"
]

# Optional. When set, creates a narrowly scoped cross-account role for the
# isolated production account to manage DNS validation and public aliases.
production_account_id = "PRODUCTION_ACCOUNT_ID"
