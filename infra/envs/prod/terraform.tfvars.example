aws_region        = "us-east-1"
github_repository = "OWNER/DreamCatcherAI"
availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

container_image = "public.ecr.aws/docker/library/nginx:stable-alpine"

callback_urls = [
  "https://dreamdna.world",
  "https://www.dreamdna.world"
]

logout_urls = [
  "https://dreamdna.world",
  "https://www.dreamdna.world"
]

cognito_domain_prefix = "dreamlens-prod-<account-id>"

alert_email = null

web_domain_aliases = [
  "dreamdna.world",
  "www.dreamdna.world"
]

# Production creates its own ACM certificate. The Route 53 zone remains in the
# shared domain account, so this role is used only for DNS validation and aliases.
hosted_zone_id          = "REPLACE_WITH_SHARED_ROUTE53_HOSTED_ZONE_ID"
dns_management_role_arn = "arn:aws:iam::DOMAIN_ACCOUNT_ID:role/dreamlens-prod-dns-manager"
api_domain_name         = "api.dreamdna.world"
