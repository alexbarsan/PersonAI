aws_region        = "us-east-1"
github_repository = "OWNER/DreamCatcherAI"
availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

container_image = "public.ecr.aws/docker/library/nginx:stable-alpine"

callback_urls = [
  "https://dreamdna.world/auth/callback",
  "https://www.dreamdna.world/auth/callback",
  "dreamlens://auth/callback"
]

logout_urls = [
  "https://dreamdna.world",
  "https://www.dreamdna.world"
]

cognito_domain_prefix = "dreamlens-prod-<account-id>"
cognito_custom_domain = "auth.dreamdna.world"
# Terraform creates and validates a dedicated us-east-1 certificate when this is null.
# Set an existing dedicated certificate ARN only when importing one intentionally.
cognito_custom_domain_certificate_arn = null

# See docs/operations/social-login.md. Supply these via untracked local tfvars
# or TF_VAR_* variables. Never commit client secrets or the Apple private key.
# google_oauth = {
#   client_id     = "...apps.googleusercontent.com"
#   client_secret = "..."
# }
# Set this only when Google is configured directly in Cognito rather than in
# google_oauth above. It keeps Google enabled on the existing App Client.
# use_existing_google_identity_provider = true
# apple_oauth = {
#   client_id   = "world.dreamdna.login"
#   team_id     = "..."
#   key_id      = "..."
#   private_key = <<-PEM
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# PEM
# }

alert_email = null

web_domain_aliases = [
  "dreamdna.world",
  "www.dreamdna.world"
]

# Production creates its own ACM certificate. The Route 53 zone remains in the
# shared domain account, so this role is used only for DNS validation and aliases.
hosted_zone_id          = "REPLACE_WITH_SHARED_ROUTE53_HOSTED_ZONE_ID"
dns_management_role_arn = "arn:aws:iam::DOMAIN_ACCOUNT_ID:role/dreamlens-prod-dns-manager"
api_domain_name         = "api.dreamdna.world"
