aws_region        = "us-east-1"
github_repository = "OWNER/DreamCatcherAI"
availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

container_image = "public.ecr.aws/docker/library/nginx:stable-alpine"

callback_urls = [
  "https://dev.dreamdna.world",
  "http://localhost:8081",
  "exp://127.0.0.1:8081"
]

logout_urls = [
  "https://dev.dreamdna.world",
  "http://localhost:8081"
]

cognito_domain_prefix = "dreamlens-dev-<account-id>"

# See docs/operations/social-login.md. Supply these via untracked local tfvars
# or TF_VAR_* variables. Never commit client secrets or the Apple private key.
# google_oauth = {
#   client_id     = "...apps.googleusercontent.com"
#   client_secret = "..."
# }
# apple_oauth = {
#   client_id   = "world.dreamdna.dev.login"
#   team_id     = "..."
#   key_id      = "..."
#   private_key = <<-PEM
# -----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# PEM
# }

alert_email = null

web_domain_aliases      = ["dev.dreamdna.world"]
web_acm_certificate_arn = null
api_acm_certificate_arn = null
hosted_zone_id          = null
api_domain_name         = "api.dev.dreamdna.world"

# Add immutable Cognito user subjects here only for controlled dev Premium testing.
premium_subjects = []
